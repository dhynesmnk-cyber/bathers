---
// Glossary index (UX.md §2.3, DESIGN.md §5b, 2026-07-22 addition) — lists
// the 10 amenity/facility terms, each linking to its own explainer page.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { AMENITY_KEYS, AMENITY_NOTATION, FACILITY_KEYS, FACILITY_LABELS } from "../../config";
import type { IconKey } from "../../icons/paths";

const LABELS: Record<string, string> = {
  ...Object.fromEntries(AMENITY_KEYS.map((key) => [key, AMENITY_NOTATION[key].full])),
  ...FACILITY_LABELS,
};
const keys = [...AMENITY_KEYS, ...FACILITY_KEYS];
const urlSlug = (k: string) => k.replace(/_/g, "-");
---

<BaseLayout
  title={`Glossary — Where We Bathe`}
  description="What the feature and facility icons on Where We Bathe mean."
  canonicalPath="/glossary/"
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <header class="mb-16">
      <h1 class="font-display font-light" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
        Glossary
      </h1>
      <p class="mono mt-2 text-[var(--ink-faded)]">What each icon on a venue entry means.</p>
    </header>

    <section aria-labelledby="contents-heading">
      <div class="mono mb-8 flex items-center gap-4 text-[var(--ink-faded)]">
        <span>CONTENTS</span>
        <span class="h-px flex-1" style="background: color-mix(in srgb, var(--ink-faded) 25%, transparent);"></span>
      </div>
      <ul class="flex flex-col gap-4">
        {
          keys.map((key) => (
            <li>
              <a href={`/glossary/${urlSlug(key)}/`} class="inline-flex items-center gap-2">
                <Icon name={key as IconKey} size={20} />
                <span>{LABELS[key]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
