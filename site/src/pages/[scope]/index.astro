---
// Programmatic index page (UX.md §2.3, TRD.md §4.2), serving two kinds off
// the same top-level /[scope]/ slot. Astro can't register two sibling
// dynamic routes at the same path depth (a second `/[x]/index.astro` would
// collide with this one), so both kinds are merged here with a `kind`
// discriminator — the same pattern [scope]/[filter].astro already uses for
// its three filter kinds:
//   - state pages (/vic/ etc.) — generated only for states with >=1 venue
//   - national amenity/facility pages (/magnesium-pool/, /pregnancy-safe/
//     etc., 2026-07-31 Gate 6 addition) — generated only for keys with >=1
//     venue nationally.
//   - national pool-setting pages (/indoor-pool/, /outdoor-pool/,
//     /natural-spring/, Gate E3 2026-08-01) — crawlable homes for the homepage
//     "By pool setting" chooser, which used to deep-link the client-only
//     /?pooltype= filter. Descriptive slugs (indoor-pool, not indoor) keep them
//     clear of the existing /category/ and /[state]/[pooltype]/ slugs; the
//     residual POOL_TYPES.other setting has no national page (see config.ts).
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VenueEntry from "../../components/VenueEntry.astro";
import Icon from "../../components/Icon.astro";
import {
  AMENITY_KEYS,
  AMENITY_NOTATION,
  CROSS_CUTTING_FACILITY_FILTERS,
  POOL_NATIONAL_FILTERS,
  STATE_NAMES,
  STATES,
  amenityUrlSlug,
} from "../../config";
import type { IconKey } from "../../icons/paths";
import forewords from "../../data/forewords.json";

type VenueList = Awaited<ReturnType<typeof getCollection<"spas">>>;
type Forewords = {
  [state: string]: { meta_description?: string } | undefined;
  national?: {
    amenities?: Record<string, string>;
    facilities?: Record<string, string>;
  };
};
const FOREWORDS = forewords as Forewords;

export async function getStaticPaths() {
  const venues = await getCollection("spas");
  const paths: { params: { scope: string }; props: Record<string, unknown> }[] = [];

  for (const state of STATES) {
    const stateVenues = venues.filter((v) => v.data.state === state);
    if (stateVenues.length === 0) continue;
    paths.push({
      params: { scope: state.toLowerCase() },
      props: { kind: "state", state, venues: stateVenues },
    });
  }

  for (const amenityKey of AMENITY_KEYS) {
    const matching = venues.filter((v) => v.data.amenities[amenityKey]);
    if (matching.length === 0) continue;
    paths.push({
      params: { scope: amenityUrlSlug(amenityKey) },
      props: { kind: "amenity-national", amenityKey, venues: matching },
    });
  }

  for (const facilityFilter of CROSS_CUTTING_FACILITY_FILTERS) {
    const matching = venues.filter((v) => v.data.facilities?.[facilityFilter.key]);
    if (matching.length === 0) continue;
    paths.push({
      params: { scope: facilityFilter.slug },
      props: { kind: "facility-national", facilityKey: facilityFilter.key, label: facilityFilter.label, slug: facilityFilter.slug, venues: matching },
    });
  }

  for (const poolFilter of POOL_NATIONAL_FILTERS) {
    const matching = venues.filter((v) => v.data.facilities?.[poolFilter.key]);
    if (matching.length === 0) continue;
    paths.push({
      params: { scope: poolFilter.slug },
      props: { kind: "facility-national", facilityKey: poolFilter.key, label: poolFilter.label, slug: poolFilter.slug, venues: matching },
    });
  }

  return paths;
}

type Props =
  | { kind: "state"; state: (typeof STATES)[number]; venues: VenueList }
  | { kind: "amenity-national"; amenityKey: (typeof AMENITY_KEYS)[number]; venues: VenueList }
  | { kind: "facility-national"; facilityKey: string; label: string; slug: string; venues: VenueList };

const props = Astro.props as Props;
const { kind, venues } = props;
const venueCount = venues.length;
const venueNoun = venueCount === 1 ? "venue" : "venues";

const state = kind === "state" ? props.state : null;
const presentAmenities = state ? AMENITY_KEYS.filter((key) => venues.some((v) => v.data.amenities[key])) : [];

let pageHeading: string;
let pageTitle: string;
let description: string;
let canonicalPath: string;
let backLink: { href: string; label: string } | null = null;

if (kind === "state" && state) {
  pageHeading = `Bathhouses of ${STATE_NAMES[state]}`;
  pageTitle = `Bathhouses & Hot Springs in ${STATE_NAMES[state]} — ${venueCount} ${venueNoun}`;
  description =
    FOREWORDS[state]?.meta_description ||
    `Find bathhouses, hot springs and saunas in ${STATE_NAMES[state]} — ${venueCount} ${venueNoun}, no sponsored listings.`;
  canonicalPath = `/${state.toLowerCase()}/`;
} else if (kind === "amenity-national") {
  const full = AMENITY_NOTATION[props.amenityKey].full;
  pageHeading = `${full} in Australia`;
  pageTitle = `${full} — ${venueCount} ${venueNoun} across Australia`;
  description =
    FOREWORDS.national?.amenities?.[props.amenityKey] ||
    `${full} at ${venueCount} bathhouses and hot springs across Australia, compared side by side.`;
  canonicalPath = `/${amenityUrlSlug(props.amenityKey)}/`;
  backLink = { href: `/glossary/${props.amenityKey.replace(/_/g, "-")}/`, label: "What is this?" };
} else {
  // Cross-cutting facility nationals (pregnancy-safe) and pool-setting
  // nationals (indoor-pool / outdoor-pool / natural-spring) render identically;
  // the route slug is carried in props so this branch stays list-agnostic.
  const { label, facilityKey, slug } = props as { label: string; facilityKey: string; slug: string };
  pageHeading = `${label} in Australia`;
  pageTitle = `${label} — ${venueCount} ${venueNoun} across Australia`;
  description =
    FOREWORDS.national?.facilities?.[facilityKey] || `${label} at ${venueCount} bathhouses and hot springs across Australia.`;
  canonicalPath = `/${slug}/`;
  backLink = { href: `/glossary/${facilityKey.replace(/_/g, "-")}/`, label: "What is this?" };
}
---

<BaseLayout title={`${pageTitle} — Where We Bathe`} description={description} canonicalPath={canonicalPath}>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <header class="mb-16">
      <h1 class="font-display font-light" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
        {pageHeading}
      </h1>
      {
        state && presentAmenities.length > 0 && (
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[var(--ink-faded)]">
            {presentAmenities.map((key) => (
              <span class="inline-flex items-center gap-1">
                <Icon name={key as IconKey} size={16} />
                <span class="mono text-sm">{AMENITY_NOTATION[key].full}</span>
              </span>
            ))}
          </p>
        )
      }
      {
        !state && (
          <p class="mt-2 mono text-sm text-[var(--ink-faded)]">
            {venueCount} {venueNoun}
          </p>
        )
      }
    </header>

    <section class="reading-spine mb-16">
      <p>{description}</p>
    </section>

    {
      state && presentAmenities.length > 0 && (
        <nav class="mb-16 flex flex-wrap gap-x-4 gap-y-2 text-[var(--ink-faded)]" aria-label="Filter by feature">
          {presentAmenities.map((key) => (
            <a href={`/${state.toLowerCase()}/${amenityUrlSlug(key)}/`} class="mono inline-flex items-center gap-1">
              <Icon name={key as IconKey} size={16} />
              {AMENITY_NOTATION[key].full}
            </a>
          ))}
        </nav>
      )
    }

    {
      backLink && (
        <nav class="mono mb-16 text-[var(--ink-faded)]">
          <a href={backLink.href}>{backLink.label}</a>
        </nav>
      )
    }

    <section aria-labelledby="contents-heading">
      <div class="mono mb-8 flex items-center gap-4 text-[var(--ink-faded)]">
        <span>CONTENTS</span>
        <span class="draw-line-on-view h-px flex-1" style="background: color-mix(in srgb, var(--ink-faded) 25%, transparent);"></span>
      </div>
      {
        venues.map((venue) => (
          <VenueEntry
            name={venue.data.name}
            slug={venue.id}
            suburb={venue.data.suburb}
            state={venue.data.state}
            summary={venue.data.summary}
            amenities={venue.data.amenities}
            facilities={venue.data.facilities}
            image={venue.data.image}
          />
        ))
      }
    </section>
  </main>
</BaseLayout>
