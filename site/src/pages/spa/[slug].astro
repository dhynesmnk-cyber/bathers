---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Features from "../../components/Features.astro";
import Pull from "../../components/Pull.astro";
import TippedPhoto from "../../components/TippedPhoto.astro";
import FAQ from "../../components/FAQ.astro";
import {
  AMENITY_KEYS,
  AMENITY_NOTATION,
  CATEGORY_LABELS,
  COUNTRY_NAMES,
  DRESS_CODE_LABELS,
  FACILITY_KEYS,
  FACILITY_LABELS,
  SESSION_GENDER_LABELS,
  STATE_NAMES,
  VERIFIABLE_FIELDS,
  VERIFIABLE_FIELD_LABELS,
  categoryUrlSlug,
  coldPlungeTemperatureLine,
  formatDistanceKm,
  nearestByDistance,
  placePath,
  priceRange,
  saunaTemperatureLine,
  type GeoPoint,
  worldRegionForCountry,
} from "../../config";

export async function getStaticPaths() {
  const venues = await getCollection("spas");

  function venueCoords(v: (typeof venues)[number]): GeoPoint | null {
    return v.data.latitude != null && v.data.longitude != null
      ? { latitude: v.data.latitude, longitude: v.data.longitude }
      : null;
  }

  return venues.map((venue) => {
    // Nearby (2026-07-25, TRD.md §8 exception) — nearest 3 other published
    // venues by straight-line distance, any category. Omitted entirely when
    // this venue has no coordinate of its own to measure from; otherwise
    // shows whatever's available even below 3 (thin neighbour pools, e.g.
    // Tasmania today, are expected as the directory grows nationally).
    const origin = venueCoords(venue);
    const nearby = origin
      ? nearestByDistance(
          origin,
          venues.filter((v) => v.id !== venue.id),
          3,
          venueCoords,
        )
      : [];
    return { params: { slug: venue.id }, props: { venue, nearby } };
  });
}

const { venue, nearby } = Astro.props;
const { data } = venue;
const { Content } = await render(venue);

// State/Province helper - used throughout the template
const stateProvince = data.state_province;
const country = data.country;

// Which details the venue's operator has confirmed directly (Gate 13,
// 2026-09-08). Until now `verification` was schema-checked and stored but never
// shown to a reader, so the strongest tier the fact model has was invisible —
// and the outreach email tells operators their confirmation will appear on the
// page, which has to be true. Ordered by VERIFIABLE_FIELDS rather than by object
// key order so the sentence reads the same on every venue.
const verificationRecords = data.verification ?? {};
const operatorConfirmed = VERIFIABLE_FIELDS.filter(
  (field) => verificationRecords[field]?.tier === "operator_confirmed",
);
// zod coerces every verification date to a Date (see content/config.ts), so
// these are Date objects, never the "YYYY-MM-DD" strings the YAML holds.
const operatorConfirmedDates = operatorConfirmed
  .map((field) => verificationRecords[field]?.date)
  .filter((d): d is Date => d instanceof Date && !Number.isNaN(d.getTime()))
  .sort((a, b) => a.getTime() - b.getTime());
// The most recent confirmation — a second round of outreach should not make the
// line say something older than the newest thing the operator told us.
const latestConfirmation = operatorConfirmedDates[operatorConfirmedDates.length - 1];
const operatorConfirmedOn = latestConfirmation
  ? latestConfirmation.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" })
  : null;
// "Price and opening hours", not "Price, Opening hours" — this reads as a
// sentence, so the labels are lowercased and the last one joined with "and".
const confirmedNames = operatorConfirmed.map((f) =>
  (VERIFIABLE_FIELD_LABELS[f] ?? f).toLowerCase(),
);
const confirmedPhrase =
  confirmedNames.length > 1
    ? `${confirmedNames.slice(0, -1).join(", ")} and ${confirmedNames[confirmedNames.length - 1]}`
    : confirmedNames[0];

// Temperature appendix line (2026-07-26) — prefer the Architect's display
// string, fall back to the structured min/max range; null when neither is set.
const saunaLine = data.temperatures ? saunaTemperatureLine(data.temperatures) : null;
const coldPlungeLine = data.temperatures ? coldPlungeTemperatureLine(data.temperatures) : null;
const temperatureLine = [saunaLine && `Sauna ${saunaLine}`, coldPlungeLine && `Cold plunge ${coldPlungeLine}`]
  .filter(Boolean)
  .join(". ");
const sessionGenderLine = [
  data.session_gender && SESSION_GENDER_LABELS[data.session_gender],
  data.session_gender_note,
]
  .filter(Boolean)
  .join(". ");

// LocalBusiness + (when present) FAQPage structured data (2026-07-24 SEO/GEO
// pass) — same facts already rendered visibly on this page (address, cost,
// FAQ.astro), just made machine-readable for search/AI crawlers too.
const localBusinessLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: data.name,
  description: data.summary,
  url: data.website,
  address: {
    "@type": "PostalAddress",
    streetAddress: data.address,
    addressLocality: data.city,
    addressRegion: STATE_NAMES[stateProvince],
    addressCountry: data.country || "AU",
  },
};
if (data.image) localBusinessLd.image = new URL(data.image, Astro.site).toString();
if (data.latitude != null && data.longitude != null) {
  localBusinessLd.geo = { "@type": "GeoCoordinates", latitude: data.latitude, longitude: data.longitude };
}
if (data.cost) {
  const range = priceRange(data.cost);
  if (range) localBusinessLd.priceRange = range;
}
// amenityFeature (Gate 11, 2026-07-31) — the same amenity/facility booleans
// shown on the page (Features.astro), made machine-readable. Generic
// LocalBusiness type retained deliberately (TRD.md §2, 2026-07-31): these
// venues aren't day spas, so a per-category DaySpa/HealthAndBeautyBusiness
// type would re-introduce the mislabel the 2026-07-26 category decision
// rejected. amenityFeature carries the specificity instead.
const featureNames = [
  ...AMENITY_KEYS.filter((k) => data.amenities[k]).map((k) => AMENITY_NOTATION[k].full),
  ...FACILITY_KEYS.filter((k) => data.facilities?.[k]).map((k) => FACILITY_LABELS[k]),
];
if (featureNames.length > 0) {
  localBusinessLd.amenityFeature = featureNames.map((name) => ({
    "@type": "LocationFeatureSpecification",
    name,
    value: true,
  }));
}

// BreadcrumbList (Gate 11) — Home > State/Province > Venue.
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    // Full geographic chain since 2026-09-08 (TRD.md §1): the breadcrumb now
    // mirrors the /places/ hierarchy the reader actually navigated, rather than
    // jumping from the homepage straight to a state.
    { "@type": "ListItem", position: 2, name: "Places", item: new URL("/places/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: worldRegionForCountry(country)!.name, item: new URL(`/places/${worldRegionForCountry(country)!.slug}/`, Astro.site).href },
    { "@type": "ListItem", position: 4, name: COUNTRY_NAMES[country], item: new URL(placePath(country), Astro.site).href },
    { "@type": "ListItem", position: 5, name: STATE_NAMES[stateProvince], item: new URL(placePath(country, stateProvince), Astro.site).href },
    { "@type": "ListItem", position: 6, name: data.name, item: new URL(`/spa/${venue.id}/`, Astro.site).href },
  ],
};

const faqLd = data.faq && data.faq.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: data.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : null;
---

<BaseLayout title={`${data.name} — Where We Bathe`} description={data.summary} image={data.image ?? `/og/${venue.id}.png`} imageAlt={`${data.name}, ${data.city}`}>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <article>
      <h1 class="font-display font-light" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
        {data.name}
      </h1>

      {/* Claim-payment redirect landing (2026-07-26) — Stripe's success_url/
          cancel_url both point back here with a ?claim= query param
          (admin/pipeline/claims.py). A static page can't read a visitor's
          query string at build time, so visibility is toggled client-side
          below. Plain in-flow notice, not a modal/toast (UX.md §3). */}
      <div
        id="claim-status-success"
        class="mono mt-6"
        style="border-top: 1px solid color-mix(in srgb, var(--thermal) 40%, transparent); background: var(--paper-raised); padding: 1rem 1.5rem;"
        hidden
      >
        Payment received — your update is being processed and will appear here shortly.
      </div>
      <div
        id="claim-status-cancelled"
        class="mono mt-6"
        style="border-top: 1px solid color-mix(in srgb, var(--oxide) 40%, transparent); background: var(--paper-raised); padding: 1rem 1.5rem;"
        hidden
      >
        Payment wasn't completed — this listing hasn't changed. Use the link in your email to try again.
      </div>

      <div class="mt-2 mb-12">
        <Features
          latitude={data.latitude}
          longitude={data.longitude}
          state={stateProvince}
          amenities={data.amenities}
          facilities={data.facilities}
          hours={data.hours}
          cost={data.cost}
        />
      </div>

      <div class="reading-spine">
        <Content components={{ Pull, TippedPhoto }} />
      </div>

      <FAQ items={data.faq ?? []} />

      {nearby.length > 0 && (
        <section class="mono mt-16" aria-labelledby="nearby-heading">
          <div class="mb-6 flex items-center gap-4 text-[var(--ink-faded)]">
            <span id="nearby-heading">NEARBY</span>
            <span class="draw-line-on-view h-px flex-1" style="background: color-mix(in srgb, var(--ink-faded) 25%, transparent);"></span>
          </div>
          <ul>
            {nearby.map(({ item, distanceKm }) => {
              const nearbyStateProvince = item.data.state_province;
              return (
              <li class="py-3" style="border-top: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent);">
                <a href={`/spa/${item.id}/`} class="font-display text-xl font-light text-[var(--ink)]">{item.data.name}</a>
                <span class="ml-2" style="color: var(--ink-faded);">
                  {item.data.city}, {STATE_NAMES[nearbyStateProvince]} — {formatDistanceKm(distanceKm)}
                </span>
              </li>
            );
            })}
          </ul>
        </section>
      )}

      <div class="mono mt-16 pt-6" style="border-top: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent); background: var(--paper-raised); padding: 1.5rem;">
        <p>{data.address}</p>
        {data.access && <p class="mt-4">{data.access}</p>}
        {/* Full cost detail — the dateline chip above compresses this to a
            price range (config.ts priceRange), so the long form lives here. */}
        {data.cost && <p class="mt-4 text-[var(--ink-faded)]">{data.cost}</p>}
        {temperatureLine && <p class="mt-4 text-[var(--ink-faded)]">{temperatureLine}</p>}
        {data.dress_code && <p class="mt-4">Dress code: {DRESS_CODE_LABELS[data.dress_code]}</p>}
        {sessionGenderLine && <p class="mt-4">{sessionGenderLine}</p>}
        {data.silence_policy && <p class="mt-4">{data.silence_policy}</p>}
        {data.phone_policy && <p class="mt-4">{data.phone_policy}</p>}
        {data.minimum_age && <p class="mt-4">Minimum age {data.minimum_age}</p>}
        {data.website && (
          <p class="mt-4">
            <a
              href={data.website}
              class="book-now-btn mono"
              target="_blank"
              rel="noopener"
              data-goatcounter-click={`book-now-click/${venue.id}`}
            >Book now</a>
          </p>
        )}
        <p class="mt-4">
          <a href={placePath(country, stateProvince)}>More bathhouses in {STATE_NAMES[stateProvince]}</a>
        </p>
        <p class="mt-4">
          <a href={`/category/${categoryUrlSlug(data.category)}/`}>More {CATEGORY_LABELS[data.category].toLowerCase()} venues</a>
        </p>
        {data.status !== "claimed" && (
          <p class="mt-4">
            <a href={`/claim/${venue.id}/`} class="book-now-btn mono">Claim this listing</a>
          </p>
        )}
        <p class="mt-4 text-[var(--ink-faded)]">
          Information verified {data.verified.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" })}
        </p>
        {
          operatorConfirmed.length > 0 && (
            <p class="mt-2 text-[var(--ink-faded)]">
              The {confirmedPhrase} {operatorConfirmed.length === 1 ? "was" : "were"} confirmed
              by the operator{operatorConfirmedOn && ` on ${operatorConfirmedOn}`}.
            </p>
          )
        }
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  // Runs on astro:page-load (fires on first load and every <ClientRouter />
  // navigation) rather than as a bare top-level script, so a visitor landing
  // here via a client-side navigation — not just a fresh full load — still
  // gets the correct banner. This page's own claim-status elements are
  // ordinary page content (not transition:persist'd), so each navigation
  // here is a fresh, correctly-hidden pair of banners re-queried from
  // scratch — no stale-state guard needed.
  document.addEventListener("astro:page-load", () => {
    const claimStatus = new URLSearchParams(window.location.search).get("claim");
    document.getElementById("claim-status-success")?.toggleAttribute("hidden", claimStatus !== "success");
    document.getElementById("claim-status-cancelled")?.toggleAttribute("hidden", claimStatus !== "cancelled");
  });
</script>
