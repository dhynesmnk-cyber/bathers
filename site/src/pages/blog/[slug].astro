---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME, videoEmbedUrl } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

// BlogPosting structured data (2026-07-24 SEO/GEO pass).
const blogPostingLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  datePublished: data.dateline.toISOString().slice(0, 10),
  description: data.summary,
  author: { "@type": "Organization", name: SITE_NAME },
  publisher: { "@type": "Organization", name: SITE_NAME },
};
if (data.cover_image) blogPostingLd.image = new URL(data.cover_image, Astro.site).toString();
---

<BaseLayout
  title={`${data.title} — ${SITE_NAME}`}
  description={data.summary}
  image={data.cover_image}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <article>
      <h1 class="font-display font-light" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
        {data.title}
      </h1>
      <div class="mt-2 mb-12 mono text-[var(--ink-faded)]">
        {data.dateline.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" })}
      </div>

      {
        data.cover_image && (
          <img
            src={data.cover_image}
            alt={data.title}
            class="mb-12 w-full"
            style="border: 3px solid var(--paper-raised);"
          />
        )
      }

      <div class="reading-spine">
        <Content />
      </div>

      {
        data.video_url && (
          <div class="mt-12" style="aspect-ratio: 16 / 9;">
            <iframe
              src={videoEmbedUrl(data.video_url)}
              class="h-full w-full"
              style="border: none;"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
        )
      }

      <div class="mono mt-16 pt-6" style="border-top: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent);">
        <a href="/blog/">More from the Journal</a>
      </div>
    </article>
  </main>
</BaseLayout>
