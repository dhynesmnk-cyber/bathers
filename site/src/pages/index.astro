---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import VenueEntry from "../components/VenueEntry.astro";
import Icon from "../components/Icon.astro";
import MarginAnimal from "../components/MarginAnimal.astro";
import SearchBox from "../components/SearchBox.astro";
import { AMENITY_KEYS, AMENITY_NOTATION, POOL_TYPES, SITE_NAME, SITE_TAGLINE, STATE_NAMES, STATES } from "../config";

const venues = await getCollection("spas");

const byState = STATES.map((state) => ({
  state,
  venues: venues.filter((v) => v.data.state === state),
})).filter((group) => group.venues.length > 0);

// Homepage chooser (DESIGN.md §5/§6/§7, 2026-07-23 exception) — features
// (formerly labelled "amenities" in copy; schema/field names unchanged, see
// SCHEMA.md) with at least one published venue, same "present only" rule as
// the corner menu's state/category lists.
const presentAmenities = AMENITY_KEYS.filter((key) => venues.some((v) => v.data.amenities?.[key]));

// 2026-07-26 — pool-setting column reinstated on the homepage chooser itself
// (DESIGN.md §5, reversing the same-day-earlier removal note), reusing the
// same POOL_TYPES.match() rule as the corner menu and /[state]/[filter]/ so
// the grouping logic isn't reimplemented a third time.
const presentPoolTypes = POOL_TYPES.filter((t) => venues.some((v) => t.match(v.data.facilities)));

// 2026-07-26 — the map is gone (DESIGN.md §5, UX.md §2.1). Every venue still
// renders server-side into the results area so it degrades to real markup,
// but stays hidden until the amenity filter and/or near-me lookup below
// (both client-side, both required-JS per UX.md §2.1) reveal a match — there
// is no default full list any more.
const allVenues = venues.map((v) => ({
  slug: v.id,
  name: v.data.name,
  suburb: v.data.suburb,
  state: v.data.state,
  summary: v.data.summary,
  amenities: v.data.amenities,
  facilities: v.data.facilities,
  latitude: v.data.latitude ?? null,
  longitude: v.data.longitude ?? null,
}));
---

<BaseLayout
  title={`${SITE_NAME} — Australian saunas, hot pools and bathhouses`}
  description={SITE_TAGLINE}
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <header class="rise-in mb-16">
      <p class="mono mt-2 text-[var(--ink-faded)]">{SITE_TAGLINE}</p>
      <p class="mono mt-3 text-[var(--ink-faded)]">Free to use. No ads. No sponsored listings.</p>
      <p class="mono mt-4"><a href="/blog/">Journal</a></p>
    </header>

    <section class="rise-in reading-spine mb-24" style="animation-delay: 90ms;">
      <p>
        There is a particular kind of quiet that arrives with heat: the first
        minutes in a sauna, a magnesium pool at 39 degrees, the sharp clarity
        of a cold plunge straight after. Bathers' is a free directory of the
        Australian venues built around that ritual — saunas, hot pools, cold
        plunges — researched properly, then set out plainly: how hot, how
        cold, and for how long.
      </p>
      <p>
        There are no ads here and no sponsored listings. Nothing ranks
        because a venue paid for it. Search by name or suburb, tell us where
        you are, or browse by state or by the feature you are after — a
        proper sweat, magnesium water, a cold shock — and choose by vibes.
      </p>
    </section>

    <section class="rise-in chooser mb-24" style="animation-delay: 180ms; position: relative;" aria-labelledby="chooser-heading">
      <MarginAnimal name="capybara" />
      <div class="mono mb-6 flex items-center gap-4 text-[var(--ink-faded)]">
        <span id="chooser-heading">START HERE</span>
        <span class="draw-line h-px flex-1" style="background: color-mix(in srgb, var(--ink-faded) 25%, transparent);"></span>
      </div>
      <p class="reading-spine mb-10">
        Search by name or suburb, tell us where you are, or browse below —
        start with a state if you know where you're headed, or a pool setting
        if you know what kind of soak you're after: indoor, outdoor, a
        natural spring, or something else. Picking either filters the
        results below.
      </p>

      <div class="finder-row">
        <div class="finder-field">
          <span class="mono chooser-group-label">Search</span>
          <SearchBox id="search-home" />
        </div>
        <div class="finder-field">
          <span class="mono chooser-group-label">Near you</span>
          <form id="near-me-form" class="mono near-me-form">
            <input
              type="text"
              id="near-me-input"
              class="near-me-input"
              placeholder="Suburb or postcode…"
              autocomplete="off"
            />
            <button type="submit" id="near-me-submit" class="near-me-btn">Find</button>
            <button type="button" id="near-me-clear" class="near-me-btn" hidden>Clear</button>
          </form>
          <p id="near-me-message" class="near-me-message" role="status" hidden></p>
          <noscript>
            <p class="mono" style="color: var(--ink-faded); margin-top: 0.5rem;">
              Finding venues near you requires JavaScript — browse by state below.
            </p>
          </noscript>
        </div>
      </div>

      <div class="chooser-groups">
        <div class="chooser-group">
          <span class="mono chooser-group-label">By state</span>
          <ul class="chooser-states">
            {byState.map((group) => (
              <li>
                <a class="mono chooser-state-link" href={`/${group.state.toLowerCase()}/`}>
                  {STATE_NAMES[group.state]}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="chooser-group">
          <span class="mono chooser-group-label">By pool setting</span>
          <ul class="chooser-states">
            {presentPoolTypes.map((t) => (
              <li>
                <a class="mono chooser-state-link" href={`/?pooltype=${t.slug}#results-heading`}>
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mono mt-12 mb-6 chooser-secondary-label">Browse by feature</div>
      <ul class="chooser-features">
        {presentAmenities.map((key) => (
          <li>
            <a class="chooser-feature-link" href={`/?amenities=${key}#results-heading`}>
              <Icon name={key} size={40} />
              <span class="mono chooser-feature-label">{AMENITY_NOTATION[key].full}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="rise-in" style="animation-delay: 270ms; position: relative;" aria-labelledby="results-heading">
      <MarginAnimal name="otter" />
      <div class="mono mb-6 flex items-center gap-4 text-[var(--ink-faded)]">
        <span id="results-heading">RESULTS</span>
        <span class="draw-line h-px flex-1" style="background: color-mix(in srgb, var(--ink-faded) 25%, transparent);"></span>
      </div>

      <div id="amenity-filters" class="mono filter-bar" hidden></div>
      <div id="pooltype-filters" class="mono filter-bar" hidden></div>

      <p id="results-direction" class="reading-spine text-[var(--ink-faded)]">
        Pick a feature or pool setting above, or tell us where you are, to see venues here.
      </p>

      <noscript>
        <p class="mono" style="color: var(--ink-faded);">
          Results require JavaScript — browse by state or feature above.
        </p>
      </noscript>

      <div id="venue-contents" hidden>
        {
          allVenues.map((venue) => (
            <VenueEntry
              name={venue.name}
              slug={venue.slug}
              suburb={venue.suburb}
              state={venue.state}
              summary={venue.summary}
              amenities={venue.amenities}
              facilities={venue.facilities}
            />
          ))
        }
      </div>
      <script
        type="application/json"
        id="venue-data"
        set:html={JSON.stringify(
          allVenues.map((v) => ({
            slug: v.slug,
            amenities: v.amenities,
            facilities: v.facilities,
            latitude: v.latitude,
            longitude: v.longitude,
          })),
        )}
      />
    </section>
  </main>
</BaseLayout>

<script>
  import { AMENITY_KEYS, AMENITY_NOTATION, POOL_TYPES, haversineDistanceKm, formatDistanceKm } from "../config";
  import { AU_PLACES } from "../data/au-places";

  interface VenueRow {
    slug: string;
    amenities: Record<string, boolean>;
    facilities: Record<string, boolean> | undefined;
    latitude: number | null;
    longitude: number | null;
  }

  const venueEls = Array.from(document.querySelectorAll<HTMLElement>("#venue-contents [data-venue-slug]"));
  const venueContents = document.getElementById("venue-contents") as HTMLElement | null;
  const directionLine = document.getElementById("results-direction") as HTMLElement | null;
  const filterBar = document.getElementById("amenity-filters") as HTMLDivElement | null;
  const pooltypeFilterBar = document.getElementById("pooltype-filters") as HTMLDivElement | null;
  const nearMeForm = document.getElementById("near-me-form") as HTMLFormElement | null;
  const nearMeInput = document.getElementById("near-me-input") as HTMLInputElement | null;
  const nearMeClearBtn = document.getElementById("near-me-clear") as HTMLButtonElement | null;
  const nearMeMessage = document.getElementById("near-me-message") as HTMLParagraphElement | null;

  if (venueContents && directionLine && filterBar && pooltypeFilterBar) {
    const rows: VenueRow[] = JSON.parse(document.getElementById("venue-data")?.textContent || "[]");
    const rowBySlug = new Map(rows.map((r) => [r.slug, r]));

    function readActiveFromUrl(): Set<string> {
      const params = new URLSearchParams(location.search);
      const raw = params.get("amenities");
      if (!raw) return new Set();
      return new Set(raw.split(",").filter((k) => (AMENITY_KEYS as readonly string[]).includes(k)));
    }

    function readPoolTypeFromUrl(): string | null {
      const raw = new URLSearchParams(location.search).get("pooltype");
      return raw && POOL_TYPES.some((t) => t.slug === raw) ? raw : null;
    }

    function writeParam(key: string, value: string | null) {
      const params = new URLSearchParams(location.search);
      if (value) params.set(key, value);
      else params.delete(key);
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
    }

    let active = readActiveFromUrl();
    let activePoolType: string | null = readPoolTypeFromUrl();

    const buttons: Record<string, HTMLButtonElement> = {};
    for (const key of AMENITY_KEYS) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "filter-toggle";
      btn.textContent = AMENITY_NOTATION[key].full;
      btn.setAttribute("aria-pressed", active.has(key) ? "true" : "false");
      btn.classList.toggle("active", active.has(key));
      btn.addEventListener("click", () => {
        if (active.has(key)) active.delete(key);
        else active.add(key);
        btn.classList.toggle("active", active.has(key));
        btn.setAttribute("aria-pressed", active.has(key) ? "true" : "false");
        writeParam("amenities", active.size > 0 ? Array.from(active).join(",") : null);
        render();
      });
      buttons[key] = btn;
      filterBar.appendChild(btn);
    }
    filterBar.hidden = false;

    // Pool setting is a single-select facet (not a stacking filter like
    // amenities) — POOL_TYPES.other is a catch-all, so allowing more than one
    // active setting at once would be confusing rather than additive.
    const poolTypeButtons: Record<string, HTMLButtonElement> = {};
    for (const poolType of POOL_TYPES) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "filter-toggle";
      btn.textContent = poolType.label;
      btn.setAttribute("aria-pressed", activePoolType === poolType.slug ? "true" : "false");
      btn.classList.toggle("active", activePoolType === poolType.slug);
      btn.addEventListener("click", () => {
        activePoolType = activePoolType === poolType.slug ? null : poolType.slug;
        for (const t of POOL_TYPES) {
          const isActive = activePoolType === t.slug;
          poolTypeButtons[t.slug].classList.toggle("active", isActive);
          poolTypeButtons[t.slug].setAttribute("aria-pressed", isActive ? "true" : "false");
        }
        writeParam("pooltype", activePoolType);
        render();
      });
      poolTypeButtons[poolType.slug] = btn;
      pooltypeFilterBar.appendChild(btn);
    }
    pooltypeFilterBar.hidden = false;

    function normalizePlace(s: string): string {
      return s
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase();
    }

    function resolvePlace(query: string) {
      const q = normalizePlace(query.trim());
      if (!q) return null;
      if (/^\d+$/.test(q)) return AU_PLACES.find((p) => p.postcode === q) ?? null;
      const exact = AU_PLACES.find((p) => normalizePlace(p.name) === q);
      if (exact) return exact;
      return AU_PLACES.find((p) => normalizePlace(p.name).includes(q)) ?? null;
    }

    function showNearMeMessage(text: string, tone?: "error") {
      nearMeMessage!.textContent = text;
      nearMeMessage!.hidden = false;
      if (tone) nearMeMessage!.dataset.tone = tone;
      else delete nearMeMessage!.dataset.tone;
    }

    const RADIUS_KM = 50;
    let currentPlace: { name: string; latitude: number; longitude: number } | null = null;

    function render() {
      const hasFilter = active.size > 0 || activePoolType !== null;
      const hasNear = currentPlace !== null;

      if (!hasFilter && !hasNear) {
        venueContents!.hidden = true;
        directionLine!.hidden = false;
        return;
      }
      directionLine!.hidden = true;
      venueContents!.hidden = false;

      const activePoolTypeDef = activePoolType ? POOL_TYPES.find((t) => t.slug === activePoolType) : null;

      let visible = venueEls.filter((el) => {
        const row = rowBySlug.get(el.dataset.venueSlug!);
        if (!row) return false;
        for (const key of active) if (!row.amenities[key]) return false;
        if (activePoolTypeDef && !activePoolTypeDef.match(row.facilities)) return false;
        return true;
      });

      if (hasNear) {
        const ranked = visible
          .map((el) => {
            const row = rowBySlug.get(el.dataset.venueSlug!)!;
            if (row.latitude == null || row.longitude == null) return null;
            const distanceKm = haversineDistanceKm(
              { latitude: currentPlace!.latitude, longitude: currentPlace!.longitude },
              { latitude: row.latitude, longitude: row.longitude },
            );
            return distanceKm <= RADIUS_KM ? { el, distanceKm } : null;
          })
          .filter((x): x is { el: HTMLElement; distanceKm: number } => x !== null)
          .sort((a, b) => a.distanceKm - b.distanceKm);

        visible.forEach((el) => {
          el.hidden = true;
          const slot = el.querySelector<HTMLElement>("[data-distance-slot]");
          if (slot) {
            slot.hidden = true;
            slot.textContent = "";
          }
        });
        for (const { el, distanceKm } of ranked) {
          el.hidden = false;
          venueContents!.appendChild(el);
          const slot = el.querySelector<HTMLElement>("[data-distance-slot]");
          if (slot) {
            slot.textContent = ` — ${formatDistanceKm(distanceKm)} away`;
            slot.hidden = false;
          }
        }
        const hiddenAll = venueEls.filter((el) => !ranked.some((r) => r.el === el));
        hiddenAll.forEach((el) => (el.hidden = true));

        if (ranked.length === 0) {
          showNearMeMessage(`No venues within ${RADIUS_KM}km of ${currentPlace!.name}.`);
        } else {
          showNearMeMessage(`Showing venues within ${RADIUS_KM}km of ${currentPlace!.name}.`);
        }
      } else {
        const visibleSlugs = new Set(visible.map((el) => el.dataset.venueSlug));
        venueEls.forEach((el) => {
          el.hidden = !visibleSlugs.has(el.dataset.venueSlug);
          const slot = el.querySelector<HTMLElement>("[data-distance-slot]");
          if (slot) {
            slot.hidden = true;
            slot.textContent = "";
          }
        });
        nearMeMessage!.hidden = true;
      }
    }

    function clearNearMe() {
      currentPlace = null;
      nearMeClearBtn!.hidden = true;
      writeParam("near", null);
      render();
    }

    function submitNearMe(query: string) {
      const place = resolvePlace(query);
      if (!place) {
        showNearMeMessage("Couldn't find that place — try a bigger nearby town, or a postcode.", "error");
        return;
      }
      currentPlace = place;
      nearMeClearBtn!.hidden = false;
      writeParam("near", query.trim());
      render();
    }

    if (nearMeForm && nearMeInput && nearMeClearBtn && nearMeMessage) {
      nearMeForm.addEventListener("submit", (e) => {
        e.preventDefault();
        submitNearMe(nearMeInput.value);
      });
      nearMeClearBtn.addEventListener("click", () => {
        nearMeInput.value = "";
        nearMeMessage.hidden = true;
        clearNearMe();
      });
      const urlNear = new URLSearchParams(location.search).get("near");
      if (urlNear) {
        nearMeInput.value = urlNear;
        submitNearMe(urlNear);
      }
    }

    render();
  }
</script>

<style>
  .finder-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent);
  }

  @media (min-width: 640px) {
    .finder-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .near-me-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }

  .near-me-input {
    flex: 1;
    min-width: 8rem;
    background: none;
    border: none;
    border-bottom: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent);
    color: var(--ink);
    padding: 0.5rem 0;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .near-me-input::placeholder {
    color: var(--ink-faded);
  }

  .near-me-input:focus-visible {
    border-bottom-color: var(--thermal);
  }

  .near-me-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ink-faded);
    cursor: pointer;
    text-underline-offset: 3px;
    text-decoration: underline;
    text-decoration-color: transparent;
  }

  .near-me-btn:hover,
  .near-me-btn:focus-visible {
    color: var(--ink);
    text-decoration-color: var(--thermal);
  }

  .near-me-message {
    margin-top: 0.5rem;
    font-size: 13px;
    color: var(--ink-faded);
  }

  .near-me-message[data-tone="error"] {
    color: var(--oxide);
  }

  .chooser-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .chooser-groups {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Quieter than .chooser-group-label's peer-section treatment — the
     feature grid is secondary to the state/pool-setting chooser above it,
     not a third equal column (2026-07-26). */
  .chooser-secondary-label {
    display: block;
    color: var(--ink-faded);
    text-transform: uppercase;
  }

  .chooser-group-label {
    display: block;
    color: var(--ink-faded);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .chooser-states {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chooser-state-link {
    font-size: 15px;
    text-decoration-color: transparent;
  }

  .chooser-state-link:hover,
  .chooser-state-link:focus-visible {
    text-decoration-color: var(--thermal);
  }

  .chooser-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chooser-feature-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 7rem;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .chooser-feature-link:hover,
  .chooser-feature-link:focus-visible {
    color: var(--thermal);
  }

  .chooser-feature-label {
    text-align: center;
    color: var(--ink-faded);
    transition: color 0.15s ease;
  }

  .chooser-feature-link:hover .chooser-feature-label,
  .chooser-feature-link:focus-visible .chooser-feature-label {
    color: var(--thermal);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.5rem;
    color: var(--ink-faded);
  }

  :global(.filter-toggle) {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ink-faded);
    cursor: pointer;
    text-underline-offset: 3px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
  }

  :global(.filter-toggle:hover),
  :global(.filter-toggle:focus-visible) {
    color: var(--ink);
  }

  :global(.filter-toggle.active) {
    color: var(--ink);
    text-decoration-color: var(--thermal);
  }
</style>
