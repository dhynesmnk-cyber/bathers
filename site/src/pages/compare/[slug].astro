---
// Comparison page (Gate 10, 2026-07-31). Superlative/constraint/occasion
// tables generated from the Gate 7 fact model (site/src/data/comparisons.ts).
// Only comparisons clearing the >=5-venue threshold generate; the rest are
// logged here at build time (skip-and-log, not a failure).
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resolveComparisons, comparePath } from "../../data/comparisons";

export async function getStaticPaths() {
  const venues = await getCollection("spas");
  const { eligible, skipped } = resolveComparisons(venues);
  for (const s of skipped) {
    console.info(`[compare] skipped '${s.slug}' — ${s.count} venue(s), below the ${5}-venue threshold`);
  }
  return eligible.map((c) => ({ params: { slug: c.slug }, props: { comparison: c } }));
}

const { comparison } = Astro.props;
const { title, metaDescription, lead, caption, columns, venues } = comparison;
const canonicalPath = comparePath(comparison.slug);

const site = Astro.site;
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  numberOfItems: venues.length,
  itemListElement: venues.map((v, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/spa/${v.id}/`, site).href,
    name: v.data.name,
  })),
};
---

<BaseLayout title={`${title} — Where We Bathe`} description={metaDescription} canonicalPath={canonicalPath}>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <nav class="mono mb-8 text-[var(--ink-faded)]" aria-label="Breadcrumb">
      <a href="/compare/">All comparisons</a>
    </nav>
    <header class="mb-10">
      <h1 class="font-display font-light" style="font-size: clamp(2.25rem, 5vw, 3.75rem);">{title}</h1>
      <p class="mt-2 mono text-sm text-[var(--ink-faded)]">{venues.length} venues</p>
    </header>

    <section class="reading-spine mb-12">
      <p>{lead}</p>
    </section>

    <div class="compare-scroll" role="region" aria-label={caption} tabindex="0">
      <table class="compare-table">
        <caption class="mono">{caption}</caption>
        <thead>
          <tr>
            <th scope="col">Venue</th>
            {columns.map((c) => <th scope="col">{c.header}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            venues.map((v) => (
              <tr>
                <th scope="row"><a href={`/spa/${v.id}/`}>{v.data.name}</a></th>
                {columns.map((c) => <td>{c.cell(v) ?? "—"}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(itemList)} is:inline />

  <style>
    .compare-scroll { overflow-x: auto; }
    .compare-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }
    .compare-table caption {
      text-align: left;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faded);
      padding-bottom: 0.75rem;
    }
    .compare-table th,
    .compare-table td {
      text-align: left;
      padding: 0.7rem 1rem 0.7rem 0;
      vertical-align: top;
    }
    .compare-table thead th {
      font-family: var(--font-mono, monospace);
      font-weight: 400;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-faded);
      border-bottom: 1px solid color-mix(in srgb, var(--ink-faded) 35%, transparent);
    }
    .compare-table tbody tr {
      border-bottom: 1px solid color-mix(in srgb, var(--ink-faded) 18%, transparent);
    }
    .compare-table tbody th[scope="row"] {
      font-weight: 400;
      padding-right: 1.5rem;
    }
  </style>
</BaseLayout>
