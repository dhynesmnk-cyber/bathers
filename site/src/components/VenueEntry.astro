---
import Notation from "./Notation.astro";
import type { AMENITY_KEYS } from "../config";

interface Props {
  name: string;
  slug: string;
  suburb: string;
  state: string;
  summary: string;
  amenities: Record<(typeof AMENITY_KEYS)[number], boolean>;
}

const { name, slug, suburb, state, summary, amenities } = Astro.props;
---

<article
  id={`venue-${slug}`}
  data-venue-slug={slug}
  class="py-6"
  style="border-top: 1px solid rgba(168,159,143,0.25); scroll-margin-top: 2rem;"
>
  <a href={`/spa/${slug}/`}>
    <h3 class="font-display text-3xl font-light text-[var(--ink)]">{name}</h3>
  </a>
  <div class="mt-1 mono text-[var(--ink-faded)]">{suburb}</div>
  <Notation state={state} amenities={amenities} compact />
  <p class="mt-2 max-w-[65ch] italic text-[var(--ink-faded)]">{summary}</p>
</article>
