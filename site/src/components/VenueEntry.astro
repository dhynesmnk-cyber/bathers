---
import Features from "./Features.astro";
import type { AMENITY_KEYS, FACILITY_KEYS } from "../config";
import { DEFAULT_COUNTRY, formatMoney } from "../config";

interface Props {
  name: string;
  slug: string;
  suburb?: string; // legacy field, kept for backward compatibility
  city?: string;   // new required field
  state_province: string;
  country: string;
  summary: string;
  amenities: Record<(typeof AMENITY_KEYS)[number], boolean>;
  facilities?: Partial<Record<(typeof FACILITY_KEYS)[number], boolean>>;
  withId?: boolean;
  image?: string;
  status?: string;
  currency?: 'AUD' | 'USD' | string;
  price?: {
    adult_drop_in?: number;
    standard_session?: number;
  };
}

const { 
  name, 
  slug, 
  suburb, 
  city, 
  state_province, 
  country, 
  summary, 
  amenities, 
  facilities, 
  withId = true, 
  image,
  status,
  currency,
  price
} = Astro.props;

// Use city if available, fallback to suburb for legacy AU venues
const displayCity = city || suburb || '';

// "Collingwood, VIC", and "High Springs, FL, US" once the venue is outside the
// default country — the same rule comparisons.ts and headtohead.ts already use,
// so one venue reads the same wherever it is listed. A list can mix countries
// (search, near-me), so the country cannot be left to the page around it.
const formatLocation = () => {
  const suffix = country && country !== DEFAULT_COUNTRY ? `, ${country}` : "";
  return `${displayCity}, ${state_province}${suffix}`;
};

const formatPrice = () =>
  price?.adult_drop_in != null ? formatMoney(price.adult_drop_in, currency, country) : null;

const locationString = formatLocation();
const priceString = formatPrice();
---

<article
  id={withId ? `venue-${slug}` : undefined}
  data-venue-slug={slug}
  class="py-6"
  style="border-top: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent); scroll-margin-top: 2rem;"
>
  <a href={`/spa/${slug}/`} class="flex items-center gap-4">
    {image && (
      <img
        src={image}
        alt=""
        transition:name={`venue-photo-${slug}`}
        class="block h-16 w-16 shrink-0 object-cover"
        loading="lazy"
      />
    )}
    {/* The pill badge that used to sit here was never rendered — no non-AU
        venue existed — and broke three DESIGN.md hard rules the moment one did:
        rounded-full, text-white, and bg-[var(--accent)] against a token that
        does not exist, which is why it rendered unfilled. global.css's
        .claim-cta comment records the same three being removed once before.
        The country belongs in the location line below, where it reads as a
        place rather than a label. */}
    <h3 data-reveal-lines class="font-display text-3xl font-light text-[var(--ink)]">{name}</h3>
  </a>
  <div class="mt-1 mono text-[var(--ink-faded)]">
    {locationString}
    <span class="mono" data-distance-slot hidden></span>
  </div>
  {priceString && (
    <div class="mt-1 text-sm font-medium text-[var(--ink)]">
      From {priceString}
    </div>
  )}
  <Features amenities={amenities} facilities={facilities} compact />
  <p data-reveal-lines class="mt-2 max-w-[65ch] italic text-[var(--ink-faded)]">{summary}</p>
  
  {status === 'unclaimed' && (
    <button
      data-open-promo-modal
      data-venue-slug={slug}
      class="claim-cta mono mt-3"
    >
      Claim this venue
    </button>
  )}
</article>
