---
import Features from "./Features.astro";
import type { AMENITY_KEYS, FACILITY_KEYS } from "../config";

interface Props {
  name: string;
  slug: string;
  suburb: string;
  state: string;
  summary: string;
  amenities: Record<(typeof AMENITY_KEYS)[number], boolean>;
  facilities?: Partial<Record<(typeof FACILITY_KEYS)[number], boolean>>;
}

const { name, slug, suburb, state, summary, amenities, facilities } = Astro.props;
---

<article
  id={`venue-${slug}`}
  data-venue-slug={slug}
  class="py-6"
  style="border-top: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent); scroll-margin-top: 2rem;"
>
  <a href={`/spa/${slug}/`}>
    <h3 class="font-display text-3xl font-light text-[var(--ink)]">{name}</h3>
  </a>
  <div class="mt-1 mono text-[var(--ink-faded)]">{suburb}</div>
  <Features state={state} amenities={amenities} facilities={facilities} compact />
  <p class="mt-2 max-w-[65ch] italic text-[var(--ink-faded)]">{summary}</p>
</article>
