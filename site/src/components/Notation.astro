---
import { AMENITY_KEYS, AMENITY_NOTATION } from "../config";

interface Props {
  latitude?: number;
  longitude?: number;
  state: string;
  amenities: Record<(typeof AMENITY_KEYS)[number], boolean>;
  compact?: boolean;
}

const { latitude, longitude, state, amenities, compact = false } = Astro.props;

const latLabel = latitude !== undefined ? `${Math.abs(latitude).toFixed(4)}° S` : null;
const lngLabel = longitude !== undefined ? `${longitude.toFixed(4)}° E` : null;
const present = AMENITY_KEYS.filter((key) => amenities[key]);
---

<p class="mono flex flex-wrap items-center gap-x-2 text-[var(--ink-faded)]">
  {
    !compact && latLabel && lngLabel && (
      <>
        <span>{latLabel}, {lngLabel}</span>
        <span aria-hidden="true">·</span>
      </>
    )
  }
  <span>{state}</span>
  {
    present.map((key) => (
      <>
        <span aria-hidden="true">·</span>
        <span tabindex="0" class="notation-item relative cursor-default text-[var(--ink)]">
          <b class="short font-medium">{AMENITY_NOTATION[key].short}</b>
          <i class="full"> {AMENITY_NOTATION[key].full}</i>
        </span>
      </>
    ))
  }
</p>

<style>
  .notation-item .full {
    display: none;
    font-family: var(--font-body);
  }
  .notation-item:hover .full,
  .notation-item:focus-within .full {
    display: inline;
  }
</style>
