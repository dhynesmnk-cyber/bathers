---
import { ICON_PATHS, type IconKey } from "../icons/paths";

interface Props {
  name: IconKey;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICON_PATHS[name]}
/>
