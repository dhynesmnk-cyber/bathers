---
// Replaces Notation.astro (2026-07-21 DESIGN.md §6 exception — icons
// replace the mono field-notation system for venue-feature display; see
// DESIGN.md §6 for the rationale and scope of the override).
import Icon from "./Icon.astro";
import { AMENITY_KEYS, AMENITY_NOTATION, FACILITY_KEYS, FACILITY_LABELS, priceRange } from "../config";
import type { IconKey } from "../icons/paths";

interface Props {
  latitude?: number | null;
  longitude?: number | null;
  state: string;
  amenities: Record<(typeof AMENITY_KEYS)[number], boolean>;
  facilities?: Partial<Record<(typeof FACILITY_KEYS)[number], boolean>>;
  hours?: string;
  cost?: string;
  compact?: boolean;
}

const { latitude, longitude, state, amenities, facilities, hours, cost, compact = false } = Astro.props;

const latLabel = latitude != null ? `${Math.abs(latitude).toFixed(4)}° S` : null;
const lngLabel = longitude != null ? `${longitude.toFixed(4)}° E` : null;

const presentAmenities = AMENITY_KEYS.filter((key) => amenities[key]);

// 2026-07-26 — pool-type facilities (indoor/outdoor/thermal-spring) are the
// "main" facilities per the homepage results list; the five logistics keys
// (parking, towels, changerooms, bookings, wheelchair access) are secondary.
// See DESIGN.md §6/Features.astro ordering note.
const POOL_TYPE_FACILITY_KEYS = ["outdoor_pool", "indoor_pool", "natural_spring"] as const;
const LOGISTICS_FACILITY_KEYS = FACILITY_KEYS.filter(
  (key) => !(POOL_TYPE_FACILITY_KEYS as readonly string[]).includes(key),
);
const presentPoolTypeFacilities = POOL_TYPE_FACILITY_KEYS.filter((key) => facilities?.[key]);
const presentLogisticsFacilities = LOGISTICS_FACILITY_KEYS.filter((key) => facilities?.[key]);

// Amenity/facility chips link to their glossary page (UX.md §2.3) — the
// glossary was previously reachable only via the corner menu. hours/cost
// have no glossary entries and stay plain spans. Key→segment conversion
// matches amenityUrlSlug (snake_case → kebab-case).
type Feature = { icon: IconKey; label: string; glossaryHref?: string; title?: string; secondary?: boolean };
const glossaryHref = (key: string) => `/glossary/${key.replace(/_/g, "-")}/`;
const features: Feature[] = [
  ...presentAmenities.map((key) => ({
    icon: key as IconKey,
    label: AMENITY_NOTATION[key].full,
    glossaryHref: glossaryHref(key),
  })),
  ...presentPoolTypeFacilities.map((key) => ({
    icon: key as IconKey,
    label: FACILITY_LABELS[key],
    glossaryHref: glossaryHref(key),
  })),
  ...(hours ? [{ icon: "hours" as IconKey, label: hours }] : []),
  // Compact price range in the summary row (full cost text lives in the
  // venue page's appendix); falls back to the raw string when no $ amount.
  ...(cost ? [{ icon: "cost" as IconKey, label: priceRange(cost) ?? cost, title: cost }] : []),
  ...presentLogisticsFacilities.map((key) => ({
    icon: key as IconKey,
    label: FACILITY_LABELS[key],
    glossaryHref: glossaryHref(key),
    secondary: true,
  })),
];
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  {
    !compact && latLabel && lngLabel && (
      <span class="mono text-[var(--ink-faded)]">{latLabel}, {lngLabel}</span>
    )
  }
  <span class="mono text-[var(--ink-faded)]">{state}</span>
  {
    features.map((feature) =>
      feature.glossaryHref ? (
        <a
          href={feature.glossaryHref}
          class="feature-chip inline-flex items-center gap-1"
          class:list={[feature.secondary ? "text-[var(--ink-faded)]" : "text-[var(--ink)]"]}
          title={feature.title ?? feature.label}
        >
          <Icon name={feature.icon} size={feature.secondary ? 14 : compact ? 16 : 18} />
          <span class:list={["mono text-sm", compact && "sr-only"]}>{feature.label}</span>
        </a>
      ) : (
        <span
          class="feature-chip inline-flex items-center gap-1"
          class:list={[feature.secondary ? "text-[var(--ink-faded)]" : "text-[var(--ink)]"]}
          title={feature.title ?? feature.label}
        >
          <Icon name={feature.icon} size={feature.secondary ? 14 : compact ? 16 : 18} />
          <span class:list={["mono text-sm", compact && "sr-only"]}>{feature.label}</span>
        </span>
      ),
    )
  }
</div>

<style>
  .feature-chip svg {
    flex-shrink: 0;
  }

  /* Same link idiom as the rest of the site: underline reserved for
     hover/focus, thermal accent — no new visual furniture. */
  a.feature-chip {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  a.feature-chip:hover,
  a.feature-chip:focus-visible {
    color: var(--thermal);
    text-decoration-color: var(--thermal);
  }
</style>
