---
// Leaflet map chapter (UX.md §2.1, DESIGN.md §5). Marker data is embedded at
// build time as JSON — the public site performs zero runtime data fetching
// except map tiles (TRD.md §4.4), so this never fetches venues.geojson.
import "leaflet/dist/leaflet.css";
import "leaflet.markercluster/dist/MarkerCluster.css";
import "leaflet.markercluster/dist/MarkerCluster.Default.css";
import { AMENITY_KEYS, type AMENITY_NOTATION } from "../config";

interface VenueMarker {
  slug: string;
  name: string;
  suburb: string;
  state: string;
  // Null when geocoding found no match (SCHEMA.md §2) — the venue gets no
  // marker but still participates in amenity filtering of the list.
  latitude: number | null;
  longitude: number | null;
  amenities: Record<(typeof AMENITY_KEYS)[number], boolean>;
}

interface Props {
  venues: VenueMarker[];
}

const { venues } = Astro.props;
---

<section class="map-chapter" aria-labelledby="map-heading">
  <div class="mono section-opener flex items-center gap-4 text-[var(--ink-faded)]">
    <span id="map-heading">MAP</span>
    <span class="h-px flex-1" style="background: color-mix(in srgb, var(--ink-faded) 25%, transparent);"></span>
  </div>

  <div id="amenity-filters" class="mono filter-bar" hidden></div>

  <div id="map-container" class="map-container" style="display: none;" aria-label="Map of venues"></div>

  <noscript>
    <p class="mono" style="color: var(--ink-faded);">Map requires JavaScript — the full index is below.</p>
  </noscript>

  <script type="application/json" id="venue-marker-data" set:html={JSON.stringify(venues)} />
</section>

<script>
  import L from "leaflet";
  import "leaflet.markercluster";
  import { AU_PLACES } from "../data/au-places";
  import { formatDistanceKm, haversineDistanceKm } from "../config";

  interface VenueMarker {
    slug: string;
    name: string;
    suburb: string;
    state: string;
    latitude: number | null;
    longitude: number | null;
    amenities: Record<string, boolean>;
  }

  const AMENITY_KEYS = ["magnesium_pool", "infrared_sauna", "traditional_sauna", "cold_plunge", "led_therapy"];
  const AMENITY_SHORT: Record<string, string> = {
    magnesium_pool: "Mg",
    infrared_sauna: "IR",
    traditional_sauna: "SA",
    cold_plunge: "CP",
    led_therapy: "LED",
  };
  const AMENITY_FULL: Record<string, string> = {
    magnesium_pool: "magnesium pool",
    infrared_sauna: "infrared sauna",
    traditional_sauna: "traditional sauna",
    cold_plunge: "cold plunge",
    led_therapy: "LED therapy",
  };

  const dataEl = document.getElementById("venue-marker-data");
  const venues: VenueMarker[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

  const mapContainer = document.getElementById("map-container") as HTMLDivElement | null;
  const filterBar = document.getElementById("amenity-filters") as HTMLDivElement | null;
  if (!mapContainer || !filterBar) {
    // Malformed page — never throw and break the rest of a static page's JS.
  } else {
    // ---- Filter state (read from URL first so a shared link reproduces the view) ----

    function readActiveFromUrl(): Set<string> {
      const params = new URLSearchParams(location.search);
      const raw = params.get("amenities");
      if (!raw) return new Set();
      return new Set(raw.split(",").filter((k) => AMENITY_KEYS.includes(k)));
    }

    function writeActiveToUrl(active: Set<string>) {
      const params = new URLSearchParams(location.search);
      if (active.size === 0) {
        params.delete("amenities");
      } else {
        params.set("amenities", Array.from(active).join(","));
      }
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
    }

    let active = readActiveFromUrl();

    function matches(v: VenueMarker): boolean {
      for (const key of active) {
        if (!v.amenities[key]) return false;
      }
      return true;
    }

    // ---- Filter bar (text toggles, DESIGN.md §5 — inline mono, no checkboxes) ----

    const buttons: Record<string, HTMLButtonElement> = {};
    for (const key of AMENITY_KEYS) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "filter-toggle";
      btn.textContent = AMENITY_FULL[key];
      btn.setAttribute("aria-pressed", active.has(key) ? "true" : "false");
      btn.classList.toggle("active", active.has(key));
      btn.addEventListener("click", () => {
        if (active.has(key)) active.delete(key);
        else active.add(key);
        btn.classList.toggle("active", active.has(key));
        btn.setAttribute("aria-pressed", active.has(key) ? "true" : "false");
        writeActiveToUrl(active);
        applyFilter();
      });
      buttons[key] = btn;
      filterBar.appendChild(btn);
    }
    filterBar.hidden = false;

    // ---- Map ----
    // Light/dark mode (DESIGN.md §5) — the basemap tile source itself
    // differs per mode (dark_all vs light_all), so it's chosen at init time
    // and re-chosen live if the visitor flips ThemeToggle's data-theme
    // attribute; the warm-dark CSS filter only applies in dark mode (see
    // <style> below, gated on [data-map-theme="dark"]).

    const TILE_URLS: Record<"light" | "dark", string> = {
      dark: "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
      light: "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
    };
    const TILE_ATTRIBUTION =
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>';

    function currentMapTheme(): "light" | "dark" {
      const explicit = document.documentElement.getAttribute("data-theme");
      if (explicit === "light" || explicit === "dark") return explicit;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    mapContainer.style.display = "";
    const map = L.map(mapContainer, { scrollWheelZoom: false });
    map.setView([-25.0, 133.0], 4);

    let mapTheme = currentMapTheme();
    mapContainer.dataset.mapTheme = mapTheme;
    let tileLayer = L.tileLayer(TILE_URLS[mapTheme], {
      attribution: TILE_ATTRIBUTION,
      subdomains: "abcd",
      maxZoom: 19,
    }).addTo(map);

    function syncMapTheme() {
      const next = currentMapTheme();
      if (next === mapTheme) return;
      mapTheme = next;
      mapContainer!.dataset.mapTheme = mapTheme;
      map.removeLayer(tileLayer);
      tileLayer = L.tileLayer(TILE_URLS[mapTheme], {
        attribution: TILE_ATTRIBUTION,
        subdomains: "abcd",
        maxZoom: 19,
      }).addTo(map);
    }

    new MutationObserver(syncMapTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncMapTheme);

    function venueIcon(isActive: boolean) {
      return L.divIcon({
        className: `venue-marker-icon${isActive ? " active" : ""}`,
        html: "<span></span>",
        iconSize: [14, 14],
      });
    }

    const markerBySlug = new Map<string, L.Marker>();
    let activeSlug: string | null = null;

    const cluster = (L as any).markerClusterGroup({
      iconCreateFunction(c: any) {
        return L.divIcon({
          className: "venue-cluster-icon",
          html: `<span>${c.getChildCount()}</span>`,
          iconSize: [28, 28],
        });
      },
    });

    let entryHighlightTimer: number | undefined;

    function setActiveMarker(slug: string | null) {
      if (activeSlug && markerBySlug.has(activeSlug)) {
        markerBySlug.get(activeSlug)!.setIcon(venueIcon(false));
      }
      activeSlug = slug;
      if (slug && markerBySlug.has(slug)) {
        markerBySlug.get(slug)!.setIcon(venueIcon(true));
      }
    }

    for (const v of venues) {
      if (v.latitude == null || v.longitude == null) continue; // no coordinate — no marker
      const marker = L.marker([v.latitude, v.longitude], { icon: venueIcon(false) });
      marker.on("click", () => {
        setActiveMarker(v.slug);
        const entry = document.getElementById(`venue-${v.slug}`);
        if (!entry) return;
        entry.scrollIntoView({ behavior: "smooth", block: "center" });
        document.querySelectorAll(".venue-entry-active").forEach((n) => n.classList.remove("venue-entry-active"));
        entry.classList.add("venue-entry-active");
        window.clearTimeout(entryHighlightTimer);
        entryHighlightTimer = window.setTimeout(() => entry.classList.remove("venue-entry-active"), 2500);
      });
      markerBySlug.set(v.slug, marker);
    }

    function applyFilter() {
      cluster.clearLayers();
      const visibleSlugs = new Set<string>();
      for (const v of venues) {
        if (!matches(v)) continue;
        visibleSlugs.add(v.slug);
        const marker = markerBySlug.get(v.slug);
        if (marker) cluster.addLayer(marker); // coordinate-less venues have no marker
      }
      document.querySelectorAll("[data-venue-slug]").forEach((el) => {
        const slug = (el as HTMLElement).dataset.venueSlug!;
        (el as HTMLElement).hidden = !visibleSlugs.has(slug);
      });
      // Group wrappers (the homepage's pool-type sections) whose entries are
      // all filtered out would otherwise leave a bare heading behind.
      document.querySelectorAll("[data-venue-group]").forEach((el) => {
        const entries = el.querySelectorAll("[data-venue-slug]");
        (el as HTMLElement).hidden =
          entries.length > 0 && !Array.from(entries).some((entry) => !(entry as HTMLElement).hidden);
      });
    }

    map.addLayer(cluster);
    applyFilter();

    // Fit the filtered subset when a shared/chooser URL carries filters, so
    // the arrival view frames those venues rather than the whole country;
    // fall back to all mappable venues when the filter matches none of them.
    const mappable = venues.filter((v) => v.latitude != null && v.longitude != null);
    const fitTargets = active.size > 0 ? mappable.filter(matches) : mappable;
    const boundsSource = fitTargets.length > 0 ? fitTargets : mappable;
    if (boundsSource.length > 0) {
      const bounds = L.latLngBounds(boundsSource.map((v) => [v.latitude!, v.longitude!] as [number, number]));
      map.fitBounds(bounds, { padding: [24, 24], maxZoom: 10 });
    }

    // ---- Near me (2026-07-25, TRD.md §8 exception) — manual location entry
    // only (never browser geolocation). Reorders the actual homepage
    // VenueEntry DOM nodes into a single "nearest to you" group rather than
    // hiding/duplicating them, so the map's existing venue-{slug} scroll
    // anchors keep working unchanged. Composes with the amenity filter above:
    // the ranked list only ever includes venues that currently pass matches(). ----

    const nearMeForm = document.getElementById("near-me-form") as HTMLFormElement | null;
    const nearMeInput = document.getElementById("near-me-input") as HTMLInputElement | null;
    const nearMeClearBtn = document.getElementById("near-me-clear") as HTMLButtonElement | null;
    const nearMeMessage = document.getElementById("near-me-message") as HTMLParagraphElement | null;
    const venueContents = document.getElementById("venue-contents") as HTMLElement | null;

    if (nearMeForm && nearMeInput && nearMeClearBtn && nearMeMessage && venueContents) {
      let nearMeGroup: HTMLElement | null = null;
      let hereMarker: L.Marker | null = null;
      // originalIndex is this element's position among its original parent's
      // children at the moment it was captured — used to restore relative
      // order on clear. A plain "next sibling" reference breaks here because
      // sibling venue entries from the same pool-type group are typically
      // moved out together, so the recorded sibling is often no longer a
      // child of that parent by the time clearNearMe() runs.
      const originalSpot = new Map<string, { parent: HTMLElement; originalIndex: number }>();

      function normalizePlace(s: string): string {
        return s
          .normalize("NFD")
          .replace(/[̀-ͯ]/g, "")
          .toLowerCase();
      }

      function resolvePlace(query: string) {
        const q = normalizePlace(query.trim());
        if (!q) return null;
        if (/^\d+$/.test(q)) {
          return AU_PLACES.find((p) => p.postcode === q) ?? null;
        }
        const exact = AU_PLACES.find((p) => normalizePlace(p.name) === q);
        if (exact) return exact;
        return AU_PLACES.find((p) => normalizePlace(p.name).includes(q)) ?? null;
      }

      function showNearMeMessage(text: string, tone?: "error") {
        nearMeMessage!.textContent = text;
        nearMeMessage!.hidden = false;
        if (tone) nearMeMessage!.dataset.tone = tone;
        else delete nearMeMessage!.dataset.tone;
      }

      function refitDefault() {
        const mappableAll = venues.filter((v) => v.latitude != null && v.longitude != null);
        const fitTargetsAll = active.size > 0 ? mappableAll.filter(matches) : mappableAll;
        const boundsSourceAll = fitTargetsAll.length > 0 ? fitTargetsAll : mappableAll;
        if (boundsSourceAll.length > 0) {
          const b = L.latLngBounds(boundsSourceAll.map((v) => [v.latitude!, v.longitude!] as [number, number]));
          map.fitBounds(b, { padding: [24, 24], maxZoom: 10 });
        }
      }

      function clearNearMe() {
        if (nearMeGroup) {
          const moved = Array.from(nearMeGroup.querySelectorAll<HTMLElement>("[data-venue-slug]"));
          // Restore in ascending original-index order so appendChild rebuilds
          // each original group's relative order rather than the distance
          // order they currently sit in within the near-me group.
          moved.sort((a, b) => {
            const ai = originalSpot.get(a.dataset.venueSlug!)?.originalIndex ?? 0;
            const bi = originalSpot.get(b.dataset.venueSlug!)?.originalIndex ?? 0;
            return ai - bi;
          });
          moved.forEach((el) => {
            const spot = originalSpot.get(el.dataset.venueSlug!);
            if (spot) spot.parent.appendChild(el);
          });
          nearMeGroup.remove();
          nearMeGroup = null;
        }
        originalSpot.clear();
        document.querySelectorAll<HTMLElement>("[data-pool-group]").forEach((el) => {
          el.hidden = false;
        });
        document.querySelectorAll<HTMLElement>("[data-distance-slot]").forEach((el) => {
          el.hidden = true;
          el.textContent = "";
        });
        if (hereMarker) {
          map.removeLayer(hereMarker);
          hereMarker = null;
        }
        nearMeClearBtn!.hidden = true;
        applyFilter();
        refitDefault();
      }

      function applyNearMe(place: { name: string; latitude: number; longitude: number }) {
        clearNearMe();

        const eligible = venues.filter((v) => matches(v));
        const withCoords = eligible.filter((v) => v.latitude != null && v.longitude != null);
        const withoutCoords = eligible.filter((v) => v.latitude == null || v.longitude == null);

        const ranked = withCoords
          .map((v) => ({
            v,
            distanceKm: haversineDistanceKm(
              { latitude: place.latitude, longitude: place.longitude },
              { latitude: v.latitude!, longitude: v.longitude! },
            ),
          }))
          .sort((a, b) => a.distanceKm - b.distanceKm);

        const group = document.createElement("div");
        group.className = "mb-12";
        group.setAttribute("data-venue-group", "");
        const heading = document.createElement("h2");
        heading.className = "mono mb-2 text-[var(--ink-faded)]";
        heading.textContent = `Nearest to ${place.name}`;
        group.appendChild(heading);

        function moveEntry(slug: string, distanceKm: number | null) {
          const el = document.querySelector<HTMLElement>(`[data-venue-slug="${CSS.escape(slug)}"][id]`);
          if (!el) return;
          const parent = el.parentElement!;
          const originalIndex = Array.from(parent.children).indexOf(el);
          originalSpot.set(slug, { parent, originalIndex });
          const slot = el.querySelector<HTMLElement>("[data-distance-slot]");
          if (slot) {
            if (distanceKm != null) {
              slot.textContent = ` — ${formatDistanceKm(distanceKm)} away`;
              slot.hidden = false;
            } else {
              slot.hidden = true;
              slot.textContent = "";
            }
          }
          group.appendChild(el);
        }

        for (const { v, distanceKm } of ranked) moveEntry(v.slug, distanceKm);
        for (const v of withoutCoords) moveEntry(v.slug, null);

        venueContents!.insertBefore(group, venueContents!.firstChild);
        nearMeGroup = group;

        document.querySelectorAll<HTMLElement>("[data-pool-group]").forEach((el) => {
          el.hidden = true;
        });
        nearMeClearBtn!.hidden = false;

        if (hereMarker) map.removeLayer(hereMarker);
        hereMarker = L.marker([place.latitude, place.longitude], {
          icon: L.divIcon({ className: "here-marker-icon", html: "<span></span>", iconSize: [16, 16] }),
        }).addTo(map);

        const nearestMappable = ranked.slice(0, 8).map((r) => r.v);
        if (nearestMappable.length > 0) {
          const bounds = L.latLngBounds([
            [place.latitude, place.longitude],
            ...nearestMappable.map((v) => [v.latitude!, v.longitude!] as [number, number]),
          ]);
          map.fitBounds(bounds, { padding: [24, 24], maxZoom: 11 });
        } else {
          map.setView([place.latitude, place.longitude], 9);
        }

        showNearMeMessage(`Showing results near ${place.name}.`);
      }

      function submitNearMe(query: string) {
        const place = resolvePlace(query);
        if (!place) {
          showNearMeMessage("Couldn't find that place — try a bigger nearby town, or a postcode.", "error");
          return;
        }
        applyNearMe(place);
        const params = new URLSearchParams(location.search);
        params.set("near", query.trim());
        history.replaceState(null, "", `?${params.toString()}`);
      }

      nearMeForm.addEventListener("submit", (e) => {
        e.preventDefault();
        submitNearMe(nearMeInput!.value);
      });

      nearMeClearBtn.addEventListener("click", () => {
        nearMeInput!.value = "";
        nearMeMessage!.hidden = true;
        clearNearMe();
        const params = new URLSearchParams(location.search);
        params.delete("near");
        const query = params.toString();
        history.replaceState(null, "", query ? `?${query}` : location.pathname);
      });

      const urlNear = new URLSearchParams(location.search).get("near");
      if (urlNear) {
        nearMeInput.value = urlNear;
        submitNearMe(urlNear);
      }
    }
  }
</script>

<style>
  .map-chapter {
    margin-bottom: 6rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--ink-faded);
  }

  :global(.filter-toggle) {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ink-faded);
    cursor: pointer;
    text-underline-offset: 3px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
  }

  :global(.filter-toggle:hover),
  :global(.filter-toggle:focus-visible) {
    color: var(--ink);
  }

  :global(.filter-toggle.active) {
    color: var(--ink);
    text-decoration-color: var(--thermal);
  }

  .map-container {
    height: min(60vh, 420px);
    border: 1px solid color-mix(in srgb, var(--ink-faded) 25%, transparent);
  }

  /* Dark mode only — the CARTO light_all basemap used in light mode needs
     little to no filtering to sit in the palette (DESIGN.md §5). */
  :global(.map-container[data-map-theme="dark"] .leaflet-tile-pane) {
    filter: sepia(0.35) hue-rotate(-15deg) saturate(0.7) brightness(0.75) contrast(1.05);
  }

  :global(.map-container[data-map-theme="light"] .leaflet-tile-pane) {
    filter: saturate(0.75) brightness(0.98) contrast(1.02);
  }

  :global(.leaflet-container) {
    background: var(--paper);
  }

  :global(.leaflet-control-attribution) {
    background: color-mix(in srgb, var(--paper) 75%, transparent) !important;
    color: var(--ink-faded) !important;
    font-family: var(--font-mono);
    font-size: 10px !important;
  }

  :global(.leaflet-control-attribution a) {
    color: var(--ink-faded) !important;
  }

  /* Leaflet 1.9+ injects a small flag icon before its own attribution link —
     the public site has no icons anywhere (DESIGN.md §5). */
  :global(.leaflet-attribution-flag) {
    display: none !important;
  }

  /* Leaflet's default CSS carries box-shadows, gradients and >2px radii on
     controls/popups/clusters — all banned on the public site (DESIGN.md §2,
     §4). Neutralise rather than rely on Leaflet's stylesheet. */
  :global(.leaflet-bar),
  :global(.leaflet-control-layers),
  :global(.leaflet-popup-tip),
  :global(.leaflet-popup-content-wrapper),
  :global(.leaflet-tooltip) {
    box-shadow: none !important;
    border-radius: 2px !important;
  }

  :global(.leaflet-bar a),
  :global(.leaflet-bar a:first-child),
  :global(.leaflet-bar a:last-child) {
    border-radius: 0 !important;
  }

  :global(.leaflet-control-zoom a) {
    background: var(--paper-raised) !important;
    color: var(--ink) !important;
    border-color: color-mix(in srgb, var(--ink-faded) 25%, transparent) !important;
  }

  :global(.leaflet-control-zoom a:focus) {
    background: var(--paper-raised) !important;
  }

  :global(.venue-marker-icon span) {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--thermal);
    background: transparent;
  }

  :global(.venue-marker-icon.active span) {
    background: var(--thermal);
  }

  :global(.here-marker-icon span) {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--oxide);
    background: var(--oxide);
  }

  :global(.venue-cluster-icon span) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--thermal);
    background: var(--paper-raised);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  :global(.venue-entry-active) {
    background: var(--paper-raised);
    transition: background-color 0.3s ease;
  }
</style>
