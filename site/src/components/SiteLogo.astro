---
// 2026-07-26 addition (DESIGN.md §5c) — the seal is the site's mascot/"main
// character": a persistent home-link logo lockup (seal artwork + wordmark)
// rendered by BaseLayout on every page, above that page's own content,
// in-flow, never fixed or floating. Reuses the seal artwork already
// prepared for margin decoration (icons/animals.ts, DESIGN.md §6a)
// recoloured the same way (CSS mask, --ink-faded light / white dark) rather
// than a second favicon-style asset.
import { ANIMAL_SRC } from "../icons/animals";
import { SITE_NAME } from "../config";

interface Props {
  large?: boolean;
}

const { large = false } = Astro.props;
---

<a href="/" class={`site-logo ${large ? "site-logo-large" : ""}`} aria-label={`${SITE_NAME} — home`}>
  <span class="site-logo-icon" style={`--animal-src: url(${ANIMAL_SRC.seal});`}></span>
  <span class="font-display font-light site-logo-text">{SITE_NAME}</span>
</a>

<style>
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-logo:hover .site-logo-text,
  .site-logo:focus-visible .site-logo-text {
    color: var(--thermal);
  }

  .site-logo-icon {
    display: inline-block;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    background-color: var(--ink-faded);
    -webkit-mask-image: var(--animal-src);
    mask-image: var(--animal-src);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .site-logo-text {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1;
  }

  /* 2026-07-31 exception (DESIGN.md §5c/§9) — the homepage masthead becomes
     a hero fixture: a centred, block-level column (icon above, wordmark
     below) rather than the default inline-flex row, with real top clearance.
     Homepage-only; the default (non-large) logo above is completely
     unchanged. */
  .site-logo-large {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2vh, 1.5rem);
    margin-top: clamp(1.5rem, 6vh, 4rem);
  }

  .site-logo-large .site-logo-icon {
    width: clamp(7rem, 30vh, 13rem);
    height: clamp(7rem, 30vh, 13rem);
  }

  .site-logo-large .site-logo-text {
    font-size: clamp(2.75rem, 6vw, 5rem);
    /* Resting state is invisible — the keyframe animation temporarily
       reveals it, not the reverse. See masthead-wordmark-flash in
       global.css for why this matters for prefers-reduced-motion. */
    opacity: 0;
    animation: masthead-wordmark-flash 2.3s ease-out both;
  }

  :root[data-theme="dark"] .site-logo-icon {
    background-color: #ffffff;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .site-logo-icon {
      background-color: #ffffff;
    }
  }
</style>
