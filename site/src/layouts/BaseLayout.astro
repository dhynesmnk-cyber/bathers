---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import CornerMenu from "../components/CornerMenu.astro";
import Footer from "../components/Footer.astro";
import GrainOverlay from "../components/GrainOverlay.astro";
import SiteLogo from "../components/SiteLogo.astro";
import { AMENITY_KEYS, AMENITY_NOTATION, CATEGORY_LABELS, GOATCOUNTER_SITE, SITE_NAME, SITE_TAGLINE, STATE_NAMES } from "../config";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, canonicalPath, image, type = "website", noindex = false } = Astro.props;
const canonicalHref = canonicalPath ?? Astro.url.pathname;
// Astro.site (site/astro.config.mjs `site:`) gives absolute URLs for
// canonical/OG/JSON-LD — search engines and AI crawlers alike expect these
// to be absolute, not root-relative (2026-07-24 SEO/GEO pass).
const canonicalUrl = new URL(canonicalHref, Astro.site);
const imageUrl = new URL(image ?? "/images/og-share.webp", Astro.site);
const isHome = Astro.url.pathname === "/";

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: Astro.site?.toString(),
  description: SITE_TAGLINE,
};

// WebSite schema (Gate 11, 2026-07-31) — sitewide, names the publisher so an
// AI crawler can tie every page back to one source. No SearchAction: the
// site's search is client-side with no crawlable results URL to point at, and
// declaring one that doesn't resolve would be worse than omitting it.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: Astro.site?.toString(),
  description: SITE_TAGLINE,
  publisher: { "@type": "Organization", name: SITE_NAME, url: Astro.site?.toString() },
};

// Sitewide search index (2026-07-25, TRD.md §8 exception) — embedded once
// here, at build time, since CornerMenu (which hosts a <SearchBox>) renders
// from this layout on every page. Same embedded-JSON pattern the homepage's
// venue data uses (index.astro's #venue-data): zero runtime fetch, read
// client-side via #search-index-data.
const searchVenues = await getCollection("spas");
const searchIndex = searchVenues.map((v) => ({
  slug: v.id,
  name: v.data.name,
  suburb: v.data.suburb,
  state: STATE_NAMES[v.data.state],
  category: CATEGORY_LABELS[v.data.category],
  amenities: AMENITY_KEYS.filter((k) => v.data.amenities?.[k]).map((k) => AMENITY_NOTATION[k].full),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("where-we-bathe-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {/* Gate 6 (SEO/AI-citation remediation) — claim pages are per-venue,
        real content, and legitimately linked from every venue page, so they
        stay crawlable (follow) but shouldn't compete with the venue's own
        page for ranking or citation. */}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script type="application/json" id="search-index-data" set:html={JSON.stringify(searchIndex)} />
    {/* Favicon — the seal mascot (DESIGN.md §5c, 2026-07-26), replacing the
        earlier inline thermal-ring SVG. Raster, not theme-aware (favicons
        render in browser chrome, outside the page's own light/dark mode). */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <!-- DESIGN.md §9 / UX.md §3, 2026-07-30 exception — governs all in-app
         navigation. Browsers without support (Firefox, early 2026) fall back
         to Astro's own documented plain-navigation behaviour automatically. -->
    <ClientRouter />
  </head>
  <body>
    <div class="page-frame">
      <GrainOverlay />
      <div class="mx-auto max-w-3xl px-6 pt-6">
        <SiteLogo large={isHome} />
      </div>
      <slot />
      <CornerMenu />
      <Footer />
    </div>
    <script
      is:inline
      data-goatcounter={`https://${GOATCOUNTER_SITE}.goatcounter.com/count`}
      async
      src="//gc.zgo.at/count.js"></script>
    <script is:inline>
      // count.js (above) auto-counts the very first page view on load;
      // <ClientRouter /> soft navigations need a manual re-count per
      // GoatCounter's documented SPA pattern (goatcounter.com/help/spa) — the
      // very first astro:page-load is skipped since count.js already
      // covered it. This registers once (Astro dedups identical inline
      // scripts across navigations) and the listener persists on
      // `document`, which survives every soft navigation.
      (function () {
        var firstLoad = true;
        document.addEventListener("astro:page-load", function () {
          if (firstLoad) {
            firstLoad = false;
            return;
          }
          if (window.goatcounter && window.goatcounter.count) {
            window.goatcounter.count({ path: location.pathname + location.search });
          }
        });
      })();
    </script>
    <script>
      // Sitewide "Notebook Depth" motion (DESIGN.md §9, 2026-07-30). Both
      // calls are needed: astro:page-load only fires once <ClientRouter />
      // is on the page (and covers every subsequent soft navigation once it
      // is); the direct call covers plain hard navigations and this page's
      // very first load either way. Calling both on a first load post-
      // <ClientRouter /> just re-runs initMotion() harmlessly (it tears down
      // and rebuilds its own triggers each time) rather than skipping it.
      import { initMotion } from "../scripts/motion";
      document.addEventListener("astro:page-load", initMotion);
      initMotion();
    </script>
  </body>
</html>
