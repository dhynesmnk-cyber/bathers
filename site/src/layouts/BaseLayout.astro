---
import { getCollection } from "astro:content";
import CornerMenu from "../components/CornerMenu.astro";
import GrainOverlay from "../components/GrainOverlay.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { AMENITY_KEYS, AMENITY_NOTATION, CATEGORY_LABELS, GOATCOUNTER_SITE, SITE_NAME, SITE_TAGLINE, STATE_NAMES } from "../config";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description, canonicalPath, image, type = "website" } = Astro.props;
const canonicalHref = canonicalPath ?? Astro.url.pathname;
// Astro.site (site/astro.config.mjs `site:`) gives absolute URLs for
// canonical/OG/JSON-LD — search engines and AI crawlers alike expect these
// to be absolute, not root-relative (2026-07-24 SEO/GEO pass).
const canonicalUrl = new URL(canonicalHref, Astro.site);
const imageUrl = new URL(image ?? "/images/og-default.webp", Astro.site);

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: Astro.site?.toString(),
  description: SITE_TAGLINE,
};

// Sitewide search index (2026-07-25, TRD.md §8 exception) — embedded once
// here, at build time, since CornerMenu (which hosts a <SearchBox>) renders
// from this layout on every page. Same embedded-JSON pattern the homepage's
// venue data uses (index.astro's #venue-data): zero runtime fetch, read
// client-side via #search-index-data.
const searchVenues = await getCollection("spas");
const searchIndex = searchVenues.map((v) => ({
  slug: v.id,
  name: v.data.name,
  suburb: v.data.suburb,
  state: STATE_NAMES[v.data.state],
  category: CATEGORY_LABELS[v.data.category],
  amenities: AMENITY_KEYS.filter((k) => v.data.amenities?.[k]).map((k) => AMENITY_NOTATION[k].full),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("bathers-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/json" id="search-index-data" set:html={JSON.stringify(searchIndex)} />
    {/* Inline SVG favicon — the map's thermal marker ring (DESIGN.md §5),
        no asset file or extra request. SVGs can't read CSS custom
        properties, so the two thermal hexes are restated here; the embedded
        media query tracks the OS scheme for the tab icon. */}
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cstyle%3Ecircle%7Bstroke:%233f6b5b%7D@media(prefers-color-scheme:dark)%7Bcircle%7Bstroke:%237fb5a4%7D%7D%3C/style%3E%3Ccircle cx='8' cy='8' r='5.5' fill='none' stroke-width='2.5'/%3E%3C/svg%3E"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-frame">
      <GrainOverlay />
      <div class="mx-auto max-w-3xl px-6 pt-6">
        <ThemeToggle />
      </div>
      <slot />
      <CornerMenu />
    </div>
    <script
      is:inline
      data-goatcounter={`https://${GOATCOUNTER_SITE}.goatcounter.com/count`}
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
