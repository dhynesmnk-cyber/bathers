# Copy to .env and fill in. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=

# Model IDs — pipeline reads these; never hardcode models in source
MODEL_HARVESTER=claude-haiku-4-5
MODEL_ARCHITECT=claude-sonnet-4-6
MODEL_GATEKEEPER=claude-haiku-4-5
# Editorial pipeline (Gate E2). MODEL_ARTICLE drafts comparison-article prose;
# MODEL_FACTCHECK is a separate role that audits the draft against venue data
# (never the drafting model reviewing itself).
MODEL_ARTICLE=claude-sonnet-4-6
MODEL_FACTCHECK=claude-sonnet-4-6

# Admin app
ADMIN_PORT=8787

# Deployed public-site origin, no trailing slash. Defaults to the Netlify
# production URL (https://bathers-directory.netlify.app) when blank; set it
# here once a custom domain exists. Used for the admin Done panel's "view"
# links.
SITE_URL=

# Netlify deploy verification (optional). The admin deploy strip pushes to
# GitHub and Netlify builds automatically; with a token (app.netlify.com →
# User settings → Applications → personal access token) the deploy log also
# polls the resulting build and reports ready/failed instead of stopping at
# "push ok". Site id defaults to the bathers-directory project.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# HTTP Basic Auth for the admin app. Leave both blank for local dev (no login
# prompt, matches prior behaviour). Required when the app is reachable beyond
# localhost (e.g. deployed to Fly.io) — set as Fly secrets there, never in a
# committed file.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Geocoding (address -> lat/lng at harvest time) — since 2026-07-22 this is
# the only source of coordinates, there is no manual reviewer fallback.
# If empty, coordinates stay null and the venue simply has no map marker.
# Nominatim requires a descriptive user agent and 1 req/sec politeness.
GEOCODER=nominatim
GEOCODER_USER_AGENT=spa-directory-admin (local, contact: you@example.com)

# No map token needed — Leaflet with free tiles per TRD.
# No database credentials — SQLite file lives at data/directory.db.

# Optional Google Places existence/data verification (harvest-time check).
# Requires a Google Cloud project with Places API (New) enabled and a
# billing account attached — this is a metered external API, ask before
# enabling. If empty, the check is skipped and nothing is auto-flagged.
#
# Also used, when set, for: (1) candidate business photos as a second image
# source alongside the harvested page's own <img> tags (Places Photo media,
# billed per photo request — a heavier usage pattern than the verification
# call alone), and (2) admin-side venue discovery/batch-seeding via Places
# Text Search (admin/pipeline/discovery.py) — a discovery run issues several
# paginated search requests per region, materially more calls than the
# per-venue verification check. Same key, same "ask before enabling" posture.
GOOGLE_PLACES_API_KEY=

# Optional GoatCounter click-tracking read-back (TRD.md §8 exception — Book
# Now button clicks only, admin-side). The public site's tracking script
# itself needs no key, only the site code (site/src/config.ts,
# GOATCOUNTER_SITE — not secret). Create a free account at goatcounter.com
# and an API token with "read stats" permission for GOATCOUNTER_API_TOKEN.
# GOATCOUNTER_SITE here must match site/src/config.ts's constant. If either
# is empty, the admin conversions panel shows "not configured".
GOATCOUNTER_API_TOKEN=
GOATCOUNTER_SITE=

# Claim-listing form/payment flow (TRD.md §8 exception, 2026-07-25). Stripe
# calls are raw httpx REST requests (no stripe pip package). Create the
# account/product/prices yourself in the Stripe dashboard and paste the
# secret key + price ids here.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Stripe dashboard -> Webhooks, or
# printed by `stripe listen` for local testing) — verifies Stripe-Signature.
STRIPE_WEBHOOK_SECRET=
# Price id for the one-off processing-fee product (mode=payment Checkout).
STRIPE_PRICE_ONEOFF=
# Price id for the $5/month unlimited-changes subscription (mode=subscription).
STRIPE_PRICE_SUBSCRIPTION=

# Outgoing mail for claim notifications/approvals/denials — stdlib smtplib,
# no new dependency. E.g. a Gmail address + app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Where new-claim notification emails go — the site owner's inbox, never a
# public address. Defaults to the same address as the claim page's old
# mailto CTA (site/src/config.ts CLAIM_EMAIL) if left blank.
CLAIM_NOTIFY_EMAIL=
# Publicly reachable base URL of the deployed admin app (e.g. the Fly.io
# URL) — used only to build a clickable link into the claim notification
# email. Leave blank to omit the link.
ADMIN_BASE_URL=
