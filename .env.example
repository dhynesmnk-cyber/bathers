# Copy to .env and fill in. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=

# Model IDs — pipeline reads these; never hardcode models in source
MODEL_HARVESTER=claude-haiku-4-5
MODEL_ARCHITECT=claude-sonnet-4-6
MODEL_GATEKEEPER=claude-haiku-4-5

# Admin app
ADMIN_PORT=8787

# HTTP Basic Auth for the admin app. Leave both blank for local dev (no login
# prompt, matches prior behaviour). Required when the app is reachable beyond
# localhost (e.g. deployed to Fly.io) — set as Fly secrets there, never in a
# committed file.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional geocoding (address -> lat/lng at harvest time).
# If empty, coordinates stay null and are set by the reviewer in the map thumbnail.
# Nominatim requires a descriptive user agent and 1 req/sec politeness.
GEOCODER=nominatim
GEOCODER_USER_AGENT=spa-directory-admin (local, contact: you@example.com)

# No map token needed — Leaflet with free tiles per TRD.
# No database credentials — SQLite file lives at data/directory.db.

# Optional Google Places existence/data verification (harvest-time check).
# Requires a Google Cloud project with Places API (New) enabled and a
# billing account attached — this is a metered external API, ask before
# enabling. If empty, the check is skipped and nothing is auto-flagged.
#
# Also used, when set, for: (1) candidate business photos as a second image
# source alongside the harvested page's own <img> tags (Places Photo media,
# billed per photo request — a heavier usage pattern than the verification
# call alone), and (2) admin-side venue discovery/batch-seeding via Places
# Text Search (admin/pipeline/discovery.py) — a discovery run issues several
# paginated search requests per region, materially more calls than the
# per-venue verification check. Same key, same "ask before enabling" posture.
GOOGLE_PLACES_API_KEY=

# Optional GoatCounter click-tracking read-back (TRD.md §8 exception — Book
# Now button clicks only, admin-side). The public site's tracking script
# itself needs no key, only the site code (site/src/config.ts,
# GOATCOUNTER_SITE — not secret). Create a free account at goatcounter.com
# and an API token with "read stats" permission for GOATCOUNTER_API_TOKEN.
# GOATCOUNTER_SITE here must match site/src/config.ts's constant. If either
# is empty, the admin conversions panel shows "not configured".
GOATCOUNTER_API_TOKEN=
GOATCOUNTER_SITE=
